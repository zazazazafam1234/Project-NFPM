DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="your-long-random-secret-here"
# 32-byte base64 key. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
API_URL="http://localhost:4000/api"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
ADMIN_KEY="your-admin-secret"
ADMIN_EMAILS="admin@example.com,another@example.com"
# PromptPay ID, LINE cookie, and QR expiry are managed in Admin > ตั้งค่าระบบ.
LINE_REVISION_DIR="/app/data"
LINE_ACCOUNTS_RELOAD_MS=30000
# Stripe PromptPay. Set these in production before enabling the Stripe option.
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
