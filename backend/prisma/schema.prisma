generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  googleId     String        @unique
  email        String        @unique
  name         String
  image        String?
  points       Int           @default(0)
  orders       Order[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Room {
  id       String  @id
  name     String
  label    String
  capacity Int     @default(4)
  orders   Order[]
}

model Plan {
  id           String  @id
  name         String
  price        Int
  duration     String
  durationDays Int
  orders       Order[]
}

model Order {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  planId        String
  plan          Plan          @relation(fields: [planId], references: [id])
  paymentMethod String
  status        String        @default("pending")
  expiresAt     DateTime?
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String    @default("📦")
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  badge       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  price       Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now())
}
